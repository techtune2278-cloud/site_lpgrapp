# À configurer dans Vercel > projet > Settings > Environment Variables.
# Ne jamais mettre de clé API dans content.json, site-settings.json ou dist.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Facultatif : par défaut les demandes arrivent sur GMAIL_USER.
CONTACT_TO_EMAIL=
CONTACT_FROM_NAME=Les plus grands racontés aux plus petits

# URL publique réelle : à changer avec le domaine, puis redéployer.
SITE_URL=https://sitelpgrapp.vercel.app

# Administration Valérie : secrets à renseigner uniquement dans Vercel.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_REPOSITORY=techtune2278-cloud/site_lpgrapp
ADMIN_GITHUB_BRANCH=main

# Facultatif : déclenchement Vercel de secours après une publication admin.
ADMIN_VERCEL_DEPLOY_HOOK=
# false pendant les ajustements ; true pour autoriser l’indexation finale.
INDEXATION_ENABLED=false
